# =====================================================================
# Latchpoint Environment Configuration
# =====================================================================

# --- Database (MySQL 8.0) ---
DB_NAME=latchpoint_db
DB_USER=latchpoint_user
DB_PASSWORD=latchpoint_secret_change_me
DB_ROOT_PASSWORD=root_secret_change_me
DB_PORT=3306

# --- Auth Core Service ---
AUTH_CORE_PORT=8080
# 256-bit secret key used to sign JWT / session tokens
JWT_SECRET=4f7b2e9d8c6a1f5e3d7b9a0c2e4f6a8b1c3d5e7f9a0b2c4d6e8f0a1b3c5d7e9f
JWT_EXPIRY_MINUTES=60
SESSION_TIMEOUT_MINUTES=30

# --- Adapter Layer Service ---
ADAPTER_LAYER_PORT=8081
# Note: Inside docker, it uses the service name 'auth-core', not localhost
AUTH_CORE_BASE_URL=http://auth-core:8080